meta {
  name: Ping (Record Active User)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/analytics/ping
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "timestamp": "2026-10-08T10:30:00.000Z",
    "platform": "mobile",
    "appVersion": 1,
    "versionName": "1.0.0"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {
    const r = res.body.recorded;
    console.log("✅", res.body.message);
    console.log("  empId:      ", r.empId);
    console.log("  Name:       ", r.name);
    console.log("  Dept:       ", r.dept);
    console.log("  Designation:", r.designation);
    console.log("  Role:       ", r.role);
    console.log("  Date:       ", r.date);
    console.log("  Last Ping:  ", r.lastPing);
    console.log("  Platform:   ", r.platform);
    console.log("  App Version:", r.appVersion);
    console.log("  Version Name:", r.versionName);
  } else if (res.status === 400) {
    console.log("❌ Bad request:", res.body.error);
  } else if (res.status === 401) {
    console.log("❌ Unauthorized — include Bearer token");
  } else {
    console.log("❌", res.body.error);
  }
}

docs {
  # Ping — Record Mobile Active User

  Call this endpoint periodically while the user is using the app on their phone.
  It records that the authenticated user was active on today's date.

  Only **one row per user per day** is stored — calling ping multiple times in the same day
  is completely safe; it just updates the `lastPing` timestamp and `appVersion`. No duplicates.

  ## When to call (Flutter)
  ```dart
  // Call on app foreground / resume, and once at login:
  Future<void> recordActivity() async {
    await api.post('/analytics/ping', body: {
      "timestamp":  DateTime.now().toUtc().toIso8601String(),
      "platform":   "mobile",
      "appVersion": 1,   // your app's integer build number
    });
  }

  // In initState or AppLifecycleState.resumed:
  recordActivity();
  ```

  ## Body fields
  | Field      | Type    | Required | Description                                               |
  |------------|---------|----------|-----------------------------------------------------------|
  | timestamp  | string  | NO       | ISO-8601 UTC string. Defaults to server time if omitted.  |
  | platform   | string  | NO       | "mobile", "tablet", etc. Defaults to "mobile".            |
  | appVersion  | integer | NO       | App build/version number (e.g. 1, 2, 12). Defaults to 0.    |
  | versionName | string  | NO       | Human-readable version string (e.g. "1.0.0"). Defaults to "". |

  ## Response
  ```json
  {
    "success": true,
    "message": "Activity recorded successfully",
    "recorded": {
      "empId":       "EMP-001",
      "name":        "Lakshmi",
      "dept":        "Software",
      "designation": "Developer",
      "role":        "Requestor",
      "date":        "2026-10-08",
      "lastPing":    "2026-10-08T05:00:00.000Z",
      "platform":    "mobile",
      "appVersion":  1,
      "versionName": "1.0.0"
    }
  }
  ```

  ## Errors
  - **400** — invalid timestamp format
  - **401** — missing or invalid JWT
}
