meta {
  name: Get Current User (me)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200) {
    const u = res.body.user;
    console.log("✅ Token is valid");
    console.log("👤 User:", u.name, "| Role:", u.role, "| Dept:", u.dept, "| EmpID:", u.empId, "| isActive:", u.isActive);
  } else if (res.status === 401) {
    console.log("❌ Token expired or invalid. Run Login first.");
  }
}

docs {
  # Get Current User

  Verifies the JWT token, fetches the user from DB, and returns the full user payload.

  Use this to confirm:
  - Token is still valid (not expired)
  - Correct user is logged in
  - Role is as expected before testing role-gated endpoints
  - `isActive` — whether the account is enabled (false = disabled by HR/SuperUser)

  Returns 401 if token is missing, expired, or account is disabled.
}
